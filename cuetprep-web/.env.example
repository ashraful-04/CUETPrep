# Base URL of the backend API.
# Local dev: http://localhost:5000
# Production: your deployed backend URL, e.g. https://api.yoursite.com
VITE_API_URL=http://localhost:5000

# Web Push VAPID public key (safe to expose — this is the public half).
# Must match VAPID_PUBLIC_KEY in the server .env.
VITE_VAPID_PUBLIC_KEY=
