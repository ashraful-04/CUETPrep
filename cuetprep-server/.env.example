NODE_ENV=development
PORT=5000

# Allowed frontend origin(s) for CORS, comma-separated (e.g. https://yoursite.com).
# Leave unset in local dev to allow all origins.
CLIENT_URL=

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<appName>

# JWT signing secret (use a long random hex string, e.g. `openssl rand -hex 64`)
JWT_SECRET=

# Shared secret for the external cron trigger (POST /api/cron/notify).
# The scheduler must send it as the `x-cron-secret` header.
# Generate with `openssl rand -hex 32`.
CRON_SECRET=

# AICredits API
AICREDITS_API_KEY=
AICREDITS_URL=https://api.aicredits.in/v1

# Web Push VAPID keys (generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
